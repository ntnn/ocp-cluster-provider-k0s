{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>openmcp-project/.github:renovate-config"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "test/e2e/.*\\.go$"
      ],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+[^\"]*\"[^:]+:(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group openmcp-project/build submodule and workflow updates",
      "matchDepNames": [
        "hack/common",
        "openmcp-project/build"
      ],
      "groupName": "openmcp-project/build"
    }
  ]
}